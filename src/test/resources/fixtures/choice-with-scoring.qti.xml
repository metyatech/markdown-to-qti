<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item
    xmlns="http://www.imsglobal.org/xsd/imsqti_v3p0"
    identifier="choice-with-scoring"
    title="Prime Number"
    adaptive="false"
    time-dependent="false">
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier">
    <qti-correct-response>
      <qti-value>CHOICE_2</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float"/>
  <qti-outcome-declaration identifier="MAXSCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>3</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-item-body>
<p>Which number is prime?</p>
    <qti-choice-interaction response-identifier="RESPONSE" max-choices="1">
      <qti-simple-choice identifier="CHOICE_1">9</qti-simple-choice>
      <qti-simple-choice identifier="CHOICE_2">11</qti-simple-choice>
      <qti-simple-choice identifier="CHOICE_3">21</qti-simple-choice>
    </qti-choice-interaction>
    <qti-rubric-block view="scorer">
      <qti-p>[2] Selects the only prime number</qti-p>
      <qti-p>[1] Avoids selecting a composite number</qti-p>
    </qti-rubric-block>
  </qti-item-body>
</qti-assessment-item>
